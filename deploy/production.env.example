# Copy this file to /etc/frota/production.env on the Linux VM and replace every CHANGE_ME value.
# Keep this file out of Git and set permissions to 0600.
FROTA_ENV_FILE=/etc/frota/production.env
FROTA_APP_IMAGE=frota-app:CHANGE_ME_COMMIT_SHA
# Use the DHCP-reserved IP of the Linux VM. UFW must allow port 8000 only from SAD61SVR001.
FROTA_APP_BIND_ADDRESS=CHANGE_ME_VM_DHCP_RESERVATION_IP
FROTA_APP_PORT=8000
FROTA_UPLOADS_DIR=/mnt/frota-share/FROTAS/frota_runtime/uploads
FROTA_BACKUP_ROOT=/mnt/frota-share/FROTAS/frota_runtime/backups
FROTA_RELEASE_ROOT=/mnt/frota-share/FROTAS/frota_runtime/releases
FROTA_STATE_ROOT=/var/lib/frota
FROTA_GIT_REPOSITORY=https://github.com/Tarmacruel/frota_postgres_local.git
FROTA_BACKUP_RETENTION=10
FROTA_HEALTH_URL=http://127.0.0.1:8000/api/health/ready

POSTGRES_DB=frota_db
POSTGRES_USER=frota_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql+asyncpg://frota_user:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/frota_db
SECRET_KEY=CHANGE_ME_GENERATE_A_48_BYTE_URLSAFE_SECRET
SIGNATURE_EVIDENCE_SECRET=CHANGE_ME_GENERATE_A_SECOND_48_BYTE_URLSAFE_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
STORAGE_DIR=/data/uploads
CORS_ORIGINS=["https://frota.sirel.com.br"]
CSRF_TRUSTED_ORIGINS=["https://frota.sirel.com.br"]
TRUSTED_HOSTS=["frota.sirel.com.br","localhost","127.0.0.1"]
# Replace with the address allocated to the Windows SAD61SVR001 host, not the VM address.
TRUSTED_PROXY_NETWORKS=["CHANGE_ME_SAD61SVR001_HOST_IP/32"]
COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=true
MAX_USER_AGENT_LENGTH=256
MAX_REQUEST_BODY_BYTES=67108864
APP_ENV=production
