<Window x:Class="FrotaSigner.Hml.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrotaSigner-HML" Height="570" Width="760"
        MinHeight="520" MinWidth="680" WindowStartupLocation="CenterScreen"
        Background="#F4F7FA">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#A3440A" Padding="18">
      <StackPanel>
        <TextBlock Text="FrotaSigner — HOMOLOGAÇÃO" Foreground="White" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Assine somente documentos identificados como teste e sem validade operacional."
                   Foreground="White" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24">
        <TextBlock Text="Dispositivo" FontSize="16" FontWeight="SemiBold" Foreground="#16324F" />
        <TextBlock x:Name="DeviceIdText" Margin="0,4,0,18" FontFamily="Consolas" TextWrapping="Wrap" />

        <Border Background="White" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel>
            <TextBlock Text="Solicitação pendente" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="EmptyStateText" Text="Aguardando uma solicitação do sistema Frota..."
                       Foreground="#53677A" Margin="0,10,0,0" />
            <Grid x:Name="RequestPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="DocumentTitleText" Grid.Row="0" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="DocumentTypeText" Grid.Row="1" Margin="0,6,0,0" />
              <TextBlock x:Name="DocumentHashText" Grid.Row="2" Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
              <ComboBox x:Name="CertificateCombo" Grid.Row="3" Margin="0,16,0,0" DisplayMemberPath="Summary" MinHeight="34" />
              <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="SignStoreButton" Content="Validar certificado instalado"
                        Padding="14,8" Click="SignStoreButton_Click" />
                <Button Content="Validar PFX/P12" Margin="10,0,0,0" Padding="14,8"
                        Click="SelectPfxButton_Click" />
                <Button Content="Recusar" Margin="10,0,0,0" Padding="14,8"
                        Click="RejectButton_Click" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Margin="0,18,0,0" Foreground="#16324F" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,18,0,0" Foreground="#53677A" TextWrapping="Wrap"
                   Text="A chave privada, o arquivo PFX e sua senha nunca são enviados ao servidor. Tokens A3 podem solicitar o PIN pelo software do fabricante." />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#E9EEF3" Padding="14">
      <TextBlock x:Name="IdleText" HorizontalAlignment="Center" Foreground="#53677A" />
    </Border>
  </Grid>
</Window>
