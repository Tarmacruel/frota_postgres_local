<Window x:Class="FrotaSigner.Hml.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha do certificado" Height="190" Width="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22">
    <TextBlock Text="Digite a senha do PFX/P12. Ela permanecerá somente neste processo."
               TextWrapping="Wrap" />
    <PasswordBox x:Name="PasswordInput" Margin="0,14,0,0" MinHeight="32" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" Padding="14,7" Click="Cancel_Click" />
      <Button Content="Continuar" Padding="14,7" Margin="8,0,0,0" Click="Continue_Click" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
